{
  "ConnectionStrings": {
    "DefaultConnection": "Host=jg-postgres;Port=5432;Database=jerrygram;Username=postgres;Password=test",
    "Redis": "jg-redis:6379"
  },
  "Elasticsearch": {
    "Url": "http://es8:9200",
    "TimeoutSeconds": 30
  },
  "Recommendation": {
    "BaseUrl": "http://jg-recommend:3001",
    "TimeoutSeconds": 3
  },
  "Kafka": {
    "BootstrapServers": "jg-kafka:29092",
    "SchemaRegistryUrl": "http://jg-kafka-connect:8083",
    "EnableIdempotence": true,
    "SecurityProtocol": "PLAINTEXT",
    "MessageTimeoutMs": 30000,
    "RequestTimeoutMs": 30000,
    "ClientId": "jerrygram-dotnet-backend",
    "EnableEventPublishing": true
  }
}
