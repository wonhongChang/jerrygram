{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=15433;Database=jerrygram;Username=postgres;Password=test",
    "Redis": "localhost:16380"
  },
  "JwtSettings": {
    "Issuer": "Jerrygram",
    "Audience": "Jerrygram-users",
    "SecretKey": "replace-with-a-long-random-local-secret-at-least-32-chars",
    "ExpiresInMinutes": 180
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "PostContainer": "post-images",
    "ProfileContainer": "profile-images"
  },
  "RedisCache": {
    "Password": "jerry1234",
    "Database": 0,
    "KeyPrefix": "jg:",
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 5,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "Cache": {
    "UseRedis": true,
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 5,
    "EnableCaching": true
  },
  "Elasticsearch": {
    "Url": "http://localhost:19200",
    "TimeoutSeconds": 30
  },
  "Recommendation": {
    "BaseUrl": "http://localhost:13001",
    "TimeoutSeconds": 3
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "SchemaRegistryUrl": "http://localhost:18083",
    "EnableIdempotence": true,
    "SecurityProtocol": "PLAINTEXT",
    "MessageTimeoutMs": 30000,
    "RequestTimeoutMs": 30000,
    "ClientId": "jerrygram-dotnet-backend",
    "EnableEventPublishing": true
  },
  "SearchTrendStreamProcessor": {
    "Enabled": true,
    "BootstrapServers": "localhost:19092",
    "Topic": "search-events",
    "ConsumerGroup": "jerrygram-search-trend-processor",
    "ClientId": "jerrygram-search-trend-processor",
    "AutoOffsetReset": "Earliest",
    "PollTimeoutMs": 1000,
    "RetentionHours": 168,
    "BucketMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:13000",
    "https://localhost:13000",
    "http://localhost:3000",
    "https://localhost:3000"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
