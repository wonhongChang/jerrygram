# Database
DATABASE_URL=postgresql://postgres:test@localhost:15433/jerrygram

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:13000,http://localhost:3000,http://localhost:5018

# Recommendation Settings
MAX_CANDIDATE_POSTS=100
MAX_RECOMMENDATIONS=10
MAX_USER_CAPTIONS=10

# Cache Settings
ENABLE_CACHE=true
CACHE_EXPIRY=3600
USE_REDIS_CACHE=true
REDIS_URL=redis://localhost:16380
REDIS_PASSWORD=
