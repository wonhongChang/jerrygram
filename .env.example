# Jerrygram local Docker ports
# Copy this file to .env and adjust values only when your machine has port conflicts.

JG_WEB_PORT=13000
JG_DOTNET_API_PORT=5018
JG_RECOMMEND_PORT=13001
JG_POSTGRES_PORT=15433
JG_REDIS_PORT=16380
JG_ELASTICSEARCH_PORT=19200
JG_ELASTICSEARCH_TRANSPORT_PORT=19300
JG_KAFKA_PORT=19092
JG_KAFKA_JMX_PORT=19997
JG_KAFKA_UI_PORT=18081
JG_KIBANA_PORT=15601
JG_LOGSTASH_BEATS_PORT=15044
JG_LOGSTASH_API_PORT=19600
JG_KAFKA_CONNECT_PORT=18083

# Local development secrets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
POSTGRES_DB=jerrygram
REDIS_PASSWORD=jerry1234

# Optional runtime integrations
OPENAI_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
CORS_ORIGINS=http://localhost:13000,http://localhost:3000,https://localhost:44342
